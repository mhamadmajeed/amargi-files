R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

PORT=4174
HTTPS_PORT=4175
APP_SECURE_COOKIES=false
APP_SESSION_SECRET=
# Optional local metadata directory. Vercel automatically falls back to /tmp when
# R2/Vercel Blob metadata storage is not configured.
DATA_DIR=

# Optional FFmpeg override. The bundled @ffmpeg-installer/ffmpeg binary is used by default.
FFMPEG_PATH=
ENABLE_SYSTEM_FFMPEG=false

# Optional persistent JSON metadata storage on Vercel.
BLOB_READ_WRITE_TOKEN=

# Optional email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
NOTIFICATION_RECIPIENTS=
